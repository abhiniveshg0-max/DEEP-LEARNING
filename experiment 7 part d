        "        ax.axis(\"off\")\n",
        "\n",
        "    fig.suptitle(f\"Generated MNIST Images - Epoch {epoch}\")\n",
        "    fig.tight_layout()\n",
        "\n",
        "    filepath = os.path.join(\n",
        "        SAVE_DIR, f\"generated_epoch_{epoch:03d}.png\"\n",
        "    )\n",
        "\n",
        "    fig.savefig(filepath, dpi=150, bbox_inches=\"tight\")\n",
        "\n",
        "    if show:\n",
        "        plt.show()\n",
        "\n",
        "    plt.close(fig)\n",
        "\n",
        "    return predictions\n",
        "\n",
        "# Display untrained Generator output\n",
        "print(\"\\nGenerated images BEFORE training\")\n",
        "save_generated_images(epoch=0)\n",
        "\n",
        "# -------------------- LOSS HISTORY --------------------------\n",
        "\n",
        "generator_losses = []\n",
        "discriminator_losses = []\n",
        "\n",
        "# -------------------- GAN TRAINING LOOP ---------------------\n",
        "\n",
        "print(\"\\nStarting GAN training...\\n\")\n",
        "\n",
        "for epoch in range(1, EPOCHS + 1):\n",
        "\n",
        "    d_batch_losses = []\n",
        "    g_batch_losses = []\n",
        "\n",
        "    for real_images in train_dataset:\n",
        "\n",
        "        batch_size = tf.shape(real_images)[0]\n",
        "\n",
        "        # Generate synthetic images from random noise\n",
        "        noise = tf.random.normal((batch_size, LATENT_DIM))\n",
        "        fake_images = generator(noise, training=True)\n",
        "\n",
        "        # REAL images receive label 1\n",
        "        real_labels = tf.ones((batch_size, 1)) * 0.9\n",
        "\n",
        "        # GENERATED images receive label 0\n",
        "        fake_labels = tf.zeros((batch_size, 1))\n",
        "\n",
        "        # Train Discriminator on real images\n",
        "        d_loss_real = discriminator.train_on_batch(\n",
        "            real_images, real_labels\n",
        "        )\n",
        "\n",
        "        # Train Discriminator on generated images\n",
        "        d_loss_fake = discriminator.train_on_batch(\n",
        "            fake_images, fake_labels\n",
        "        )\n",
        "\n",
        "        # Average real and fake losses\n",
        "        d_loss = 0.5 * (\n",
        "            float(d_loss_real) + float(d_loss_fake)\n",
        "        )\n",
        "\n",
        "        # Train Generator through combined GAN.\n",
        "        # Generator wants the Discriminator to predict REAL (1).\n",
        "        noise = tf.random.normal((batch_size, LATENT_DIM))\n",
        "        misleading_labels = tf.ones((batch_size, 1))\n",
        "\n",
        "        g_loss = gan.train_on_batch(\n",
        "            noise, misleading_labels\n",
        "        )\n",
        "\n",
        "        d_batch_losses.append(d_loss)\n",
        "        g_batch_losses.append(float(g_loss))\n",
        "\n",
        "    # Average losses for the epoch\n",
        "    avg_d_loss = float(np.mean(d_batch_losses))\n",
        "    avg_g_loss = float(np.mean(g_batch_losses))\n",
        "\n",
        "    discriminator_losses.append(avg_d_loss)\n",
        "    generator_losses.append(avg_g_loss)\n",
        "\n",
        "    print(f\"Epoch {epoch}/{EPOCHS} - D loss: {avg_d_loss:.4f} - G loss: {avg_g_loss:.4f}\")\n",
        "    save_generated_images(epoch, show=True)"
      ]
    }
  ]
