        "\n",
        "def save_generated_images(epoch, show=True):\n",
        "    \"\"\"Generate and save a 4x4 image grid.\"\"\"\n",
        "    predictions = generator(fixed_noise, training=False).numpy()\n",
        "\n",
        "    # Convert from [-1, 1] to [0, 1]\n",
