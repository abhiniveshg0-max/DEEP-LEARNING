        "from PIL import Image\n",
        "\n",
        "# -------------------- STUDENT DETAILS -----------------------\n",
        "\n",
        "STUDENT_NAME = \"YOUR NAME\"\n",
        "ROLL_NUMBER = \"YOUR ROLL NUMBER\"\n",
        "\n",
        "print(\"Student Name:\", STUDENT_NAME)\n",
        "print(\"Student Roll No:\", ROLL_NUMBER)\n",
        "print(\"TensorFlow Version:\", tf.__version__)\n",
        "\n",
        "# -------------------- PARAMETERS ----------------------------\n",
        "\n",
        "LATENT_DIM = 100\n",
        "BATCH_SIZE = 128\n",
        "EPOCHS = 10\n",
        "SAVE_DIR = \"/content/gan_results\"\n",
        "\n",
        "os.makedirs(SAVE_DIR, exist_ok=True)\n",
        "\n",
        "tf.random.set_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# -------------------- LOAD MNIST DATASET --------------------\n",
        "\n",
        "(x_train, _), (x_test, y_test) = (\n",
        "    tf.keras.datasets.mnist.load_data()\n",
        ")\n",
        "\n",
        "# Normalize images to [-1, 1]\n",
        "x_train = x_train.astype(\"float32\") / 127.5 - 1.0\n",
        "x_test = x_test.astype(\"float32\") / 127.5 - 1.0\n",
        "\n",
        "# Add grayscale channel\n",
        "x_train = np.expand_dims(x_train, axis=-1)\n",
        "x_test = np.expand_dims(x_test, axis=-1)\n",
        "\n",
        "train_dataset = (\n",
        "    tf.data.Dataset.from_tensor_slices(x_train)\n",
        "    .shuffle(10000)\n",
        "    .batch(BATCH_SIZE, drop_remainder=True)\n",
        "    .prefetch(tf.data.AUTOTUNE)\n",
        ")\n",
        "\n",
        "print(\"\\nTraining images:\", x_train.shape)\n",
        "print(\"Testing images:\", x_test.shape)\n",
        "\n",
        "# -------------------- BUILD GENERATOR -----------------------\n",
        "\n",
        "generator = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(LATENT_DIM,)),\n",
        "\n",
        "    tf.keras.layers.Dense(7 * 7 * 128, use_bias=False),\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    tf.keras.layers.Reshape((7, 7, 128)),\n",
        "\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        64, 5, strides=2, padding=\"same\", use_bias=False\n",
        "    ),\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        1, 5, strides=2, padding=\"same\",\n",
        "        activation=\"tanh\"\n",
        "    )\n",
        "], name=\"Generator\")\n",
        "\n",
        "# -------------------- BUILD DISCRIMINATOR -------------------\n",
        "\n",
        "discriminator = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(28, 28, 1)),\n",
        "\n",
        "    tf.keras.layers.Conv2D(\n",
        "        64, 5, strides=2, padding=\"same\"\n",
        "    ),\n",
        "    tf.keras.layers.LeakyReLU(negative_slope=0.2),\n",
        "    tf.keras.layers.Dropout(0.3),\n",
        "\n",
        "    tf.keras.layers.Conv2D(\n",
        "        128, 5, strides=2, padding=\"same\"\n",
        "    ),\n",
        "    tf.keras.layers.LeakyReLU(negative_slope=0.2),\n",
        "    tf.keras.layers.Dropout(0.3),\n",
        "\n",
        "    tf.keras.layers.Flatten(),\n",
        "    tf.keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "], name=\"Discriminator\")\n",
        "\n",
        "# Compile the Discriminator while it is trainable\n",
        "discriminator.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0002),\n",
        "    loss=\"binary_crossentropy\"\n",
        ")\n",
        "\n",
        "# -------------------- BUILD COMBINED GAN --------------------\n",
        "\n",
        "# Freeze Discriminator inside the combined GAN\n",
        "discriminator.trainable = False\n",
        "\n",
        "gan_input = tf.keras.layers.Input(shape=(LATENT_DIM,))\n",
        "fake_image = generator(gan_input)\n",
        "gan_output = discriminator(fake_image)\n",
        "\n",
        "gan = tf.keras.Model(\n",
        "    gan_input, gan_output, name=\"Combined_GAN\"\n",
        ")\n",
        "\n",
        "gan.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0002),\n",
        "    loss=\"binary_crossentropy\"\n",
        ")\n",
        "\n",
        "print(\"\\nGenerator Summary\")\n",
