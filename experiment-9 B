      "source": [
        "# Optimized Fine-tuning Loop using Automatic Mixed Precision (AMP)\n",
        "import torch\n",
        "from torch.optim import AdamW\n",
        "from transformers import AutoModelForSequenceClassification\n",
        "\n",
        "# Configure device\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Using device:\", device)\n",
        "\n",
        "# --- Setup / Definitions (Re-defined since previous cell was deleted) ---\n",
        "# Replace these with your actual DataLoader and Tokenizer from Part A\n",
        "num_epochs = 2\n",
        "learning_rate = 2e-5\n",
        "model_name = \"bert-base-uncased\"\n",
        "\n",
        "# Load model\n",
        "model = AutoModelForSequenceClassification.from_pretrained(model_name, num_labels=2)\n",
        "model.to(device)\n",
        "\n",
        "# Setup optimizer\n",
        "optimizer = AdamW(model.parameters(), lr=learning_rate)\n",
        "\n",
        "# 1. Initialize scaler for mixed precision using the modern torch.amp API\n",
        "# Note: GradScaler is only active when training on CUDA (GPU)\n",
        "scaler = torch.amp.GradScaler('cuda', enabled=(device.type == 'cuda'))\n",
        "\n",
        "# 2. Optimized Training Loop\n",
        "# (Ensure 'train_loader' is already defined from your data preparation step)\n",
        "if 'train_loader' in globals():\n",
        "    for epoch in range(num_epochs):\n",
        "        model.train()\n",
        "        total_loss = 0\n",
        "\n",
        "        for step, batch in enumerate(train_loader, start=1):\n",
        "            # Transfer batch to GPU\n",
        "            batch = {k: v.to(device) for k, v in batch.items()}\n",
        "\n",
        "            # Clears gradients\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            # Runs the forward pass under autocast for FP16 precision\n",
        "            with torch.amp.autocast(device_type='cuda', enabled=(device.type == 'cuda')):\n",
        "                outputs = model(**batch)\n",
        "                loss = outputs.loss\n",
        "\n",
        "            # Scales the loss and performs backward pass\n",
        "            scaler.scale(loss).backward()\n",
        "\n",
        "            # Gradient clipping to prevent exploding gradients\n",
        "            scaler.unscale_(optimizer)\n",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n",
        "\n",
        "            # Optimizer step using scaler\n",
        "            scaler.step(optimizer)\n",
        "            scaler.update()\n",
        "\n",
        "            total_loss += loss.item()\n",
        "            if step % 100 == 0:\n",
        "                print(f\"Epoch {epoch+1} | Step {step}/{len(train_loader)} | Loss: {loss.item():.4f}\")\n",
        "\n",
        "        print(f\"==> Epoch {epoch+1} average training loss: {total_loss/len(train_loader):.4f}\\n\")\n",
        "else:\n",
        "    print(\"Training loop configured! Please define 'train_loader' from Part A to begin training.\")"
