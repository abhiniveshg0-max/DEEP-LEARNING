        "# =========================================================\n",
        "# PART C: BUILDING THE CHATBOT INTERFACE\n",
        "# Student Name: YOUR NAME\n",
        "# Student Roll No: YOUR ROLL NUMBER\n",
        "# =========================================================\n",
        "\n",
        "# STEP 1: INSTALL REQUIRED LIBRARIES\n",
        "!pip install -q gradio transformers torch\n",
        "\n",
        "# STEP 2: IMPORT LIBRARIES\n",
        "import torch\n",
        "import gradio as gr\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "\n",
        "# STEP 3: DISPLAY STUDENT DETAILS\n",
        "STUDENT_NAME = \"YOUR NAME\"\n",
        "ROLL_NUMBER = \"YOUR ROLL NUMBER\"\n",
        "\n",
        "print(\"Student Name:\", STUDENT_NAME)\n",
        "print(\"Student Roll No:\", ROLL_NUMBER)\n",
        "\n",
        "# STEP 4: LOAD THE PRETRAINED LANGUAGE MODEL\n",
        "MODEL_NAME = \"distilbert/distilgpt2\"\n",
        "\n",
        "print(\"Loading chatbot model...\")\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "model = AutoModelForCausalLM.from_pretrained(MODEL_NAME)\n",
        "\n",
        "# Set padding token\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "\n",
        "# Use GPU if available\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "model = model.to(device)\n",
        "model.eval()\n",
        "\n",
        "print(\"Chatbot model loaded successfully!\")\n",
        "print(\"Device:\", device)\n",
        "\n",
        "# STEP 5: DEFINE THE CHATBOT FUNCTION\n",
        "def chatbot(message, history):\n",
        "\n",
        "    if not message.strip():\n",
        "        return \"Please enter a message.\"\n",
        "\n",
        "    # Build a prompt using recent conversation history\n",
        "    prompt = \"\"\n",
        "\n",
        "    for item in history[-4:]:\n",
        "        if isinstance(item, dict):\n",
        "            role = item.get(\"role\", \"\")\n",
        "            content = item.get(\"content\", \"\")\n",
        "\n",
        "            if isinstance(content, str):\n",
        "                if role == \"user\":\n",
        "                    prompt += f\"User: {content}\\n\"\n",
        "                elif role == \"assistant\":\n",
        "                    prompt += f\"Assistant: {content}\\n\"\n",
        "\n",
        "        elif isinstance(item, (list, tuple)) and len(item) == 2:\n",
        "            user_text, bot_text = item\n",
        "            if user_text:\n",
        "                prompt += f\"User: {user_text}\\n\"\n",
        "            if bot_text:\n",
        "                prompt += f\"Assistant: {bot_text}\\n\"\n",
        "\n",
        "    prompt += f\"User: {message}\\nAssistant:\"\n",
        "\n",
        "    # Tokenize the prompt\n",
        "    inputs = tokenizer(\n",
        "        prompt,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        max_length=800\n",
        "    ).to(device)\n",
        "\n",
        "    # Generate a response\n",
        "    with torch.no_grad():\n",
        "        outputs = model.generate(\n",
        "            **inputs,\n",
        "            max_new_tokens=80,\n",
        "            do_sample=True,\n",
        "            temperature=0.8,\n",
        "            top_p=0.9,\n",
        "            repetition_penalty=1.2,\n",
        "            pad_token_id=tokenizer.eos_token_id,\n",
        "            eos_token_id=tokenizer.eos_token_id\n",
        "        )\n",
        "\n",
        "    # Extract only the newly generated text\n",
        "    new_tokens = outputs[0][inputs[\"input_ids\"].shape[1]:]\n",
        "    response = tokenizer.decode(\n",
        "        new_tokens,\n",
        "        skip_special_tokens=True\n",
        "    ).strip()\n",
        "\n",
        "    # Stop at the next conversation turn\n",
        "    for stop_word in [\"\\nUser:\", \"\\nAssistant:\"]:\n",
        "        if stop_word in response:\n",
        "            response = response.split(stop_word)[0].strip()\n",
        "\n",
        "    if not response:\n",
        "        response = \"I couldn't generate a response. Please try again.\"\n",
        "\n",
        "    return response\n",
        "\n",
        "# STEP 6: CREATE THE GRADIO CHATBOT INTERFACE\n",
        "demo = gr.ChatInterface(\n",
        "    fn=chatbot,\n",
        "    title=\"AI Chatbot\",\n",
        "    description=(\n",
        "        f\"Student Name: {STUDENT_NAME} | \"\n",
        "        f\"Roll Number: {ROLL_NUMBER}\\n\\n\"\n",
        "        \"Enter a message to interact with the AI chatbot.\"\n",
        "    ),\n",
        "    chatbot=gr.Chatbot(height=400),\n",
        "    textbox=gr.Textbox(\n",
        "        placeholder=\"Type your message here...\",\n",
        "        container=False\n",
        "    ),\n",
        "    examples=[\n",
        "        \"Hello!\",\n",
        "        \"What is artificial intelligence?\",\n",
        "        \"Explain Python in simple words.\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "# STEP 7: LAUNCH THE WEB INTERFACE\n",
        "print(\"Launching chatbot interface...\")\n",
        "\n",
        "demo.launch(share=True)"
      ]
    }
