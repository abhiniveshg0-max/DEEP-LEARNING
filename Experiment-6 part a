        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import re\n",
        "import matplotlib.pyplot as plt\n",
        "from tensorflow.keras.datasets import imdb\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "ROLL_NO = \"YOUR_ROLL_NO\"\n",
        "\n",
        "vocab_size = 10000\n",
        "max_length = 200\n",
        "oov_token = \"<OOV>\"\n",
        "\n",
        "(x_train_raw, y_train), (x_test_raw, y_test) = imdb.load_data(num_words=vocab_size)\n",
        "\n",
        "print(\"Roll No:\", ROLL_NO)\n",
        "print(\"Training samples:\", len(x_train_raw))\n",
        "print(\"Testing samples:\", len(x_test_raw))\n",
        "print(\"Positive training samples:\", np.sum(y_train == 1))\n",
        "print(\"Negative training samples:\", np.sum(y_train == 0))\n",
        "\n",
        "word_index = imdb.get_word_index()\n",
        "reverse_word_index = {value + 3: key for key, value in word_index.items()}\n",
        "reverse_word_index[0] = \"<PAD>\"\n",
        "reverse_word_index[1] = \"<START>\"\n",
        "reverse_word_index[2] = \"<UNK>\"\n",
        "reverse_word_index[3] = \"<UNUSED>\"\n",
        "\n",
        "def decode_review(review):\n",
        "    return \" \".join(reverse_word_index.get(i, \"?\") for i in review)\n",
        "\n",
        "print(\"\\nSample Positive Review:\")\n",
        "print(decode_review(x_train_raw[np.where(y_train == 1)[0][0]])[:1000])\n",
        "\n",
        "print(\"\\nSample Negative Review:\")\n",
        "print(decode_review(x_train_raw[np.where(y_train == 0)[0][0]])[:1000])\n",
        "\n",
        "train_texts = [decode_review(review) for review in x_train_raw]\n",
        "test_texts = [decode_review(review) for review in x_test_raw]\n",
        "\n",
        "def preprocess_text(text):\n",
        "    text = text.lower()\n",
        "    text = re.sub(r\"[^a-zA-Z\\s]\", \"\", text)\n",
        "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
        "    return text\n",
        "\n",
        "train_texts = [preprocess_text(text) for text in train_texts]\n",
        "test_texts = [preprocess_text(text) for text in test_texts]\n",
        "\n",
        "tokenizer = Tokenizer(num_words=vocab_size, oov_token=oov_token)\n",
        "tokenizer.fit_on_texts(train_texts)\n",
        "\n",
        "train_sequences = tokenizer.texts_to_sequences(train_texts)\n",
        "test_sequences = tokenizer.texts_to_sequences(test_texts)\n",
        "\n",
        "x_train = pad_sequences(\n",
        "    train_sequences,\n",
        "    maxlen=max_length,\n",
        "    padding=\"post\",\n",
        "    truncating=\"post\"\n",
        ")\n",
        "\n",
        "x_test = pad_sequences(\n",
        "    test_sequences,\n",
        "    maxlen=max_length,\n",
        "    padding=\"post\",\n",
        "    truncating=\"post\"\n",
        ")\n",
        "\n",
        "y_train = np.array(y_train)\n",
        "y_test = np.array(y_test)\n",
        "\n",
        "print(\"\\nVocabulary size:\", len(tokenizer.word_index))\n",
        "print(\"Training sequence shape:\", x_train.shape)\n",
        "print(\"Testing sequence shape:\", x_test.shape)\n",
        "print(\"Training labels shape:\", y_train.shape)\n",
        "print(\"Testing labels shape:\", y_test.shape)\n",
        "\n",
        "print(\"\\nFirst preprocessed review:\")\n",
        "print(train_texts[0][:1000])\n",
        "\n",
        "print(\"\\nFirst numerical sequence:\")\n",
        "print(x_train[0])\n",
        "\n",
        "print(\"\\nFirst label:\")\n",
        "print(y_train[0])\n",
        "\n",
        "print(\"\\nClass Distribution:\")\n",
        "print(\"Negative:\", np.sum(y_train == 0))\n",
        "print(\"Positive:\", np.sum(y_train == 1))\n",
        "\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.bar([\"Negative\", \"Positive\"], [\n",
        "    np.sum(y_train == 0),\n",
        "    np.sum(y_train == 1)\n",
        "])\n",
        "plt.xlabel(\"Sentiment\")\n",
        "plt.ylabel(\"Number of Reviews\")\n",
        "plt.title(\"IMDB Sentiment Class Distribution\")\n",
        "plt.show()"
