      "source": [
        "# ===== EXPT 10 - PART B: PROMPT HANDLING AND RESPONSE GENERATION =====\n",
        "# Name: <YOUR NAME>        Roll No: <YOUR ROLL NO>\n",
        "\n",
        "!pip install -q transformers torch accelerate\n",
        "\n",
        "import torch\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "\n",
        "# ---------- Load model (same as Part A) ----------\n",
        "MODEL_NAME = \"Qwen/Qwen2.5-0.5B-Instruct\"\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    torch_dtype=torch.float16 if device == \"cuda\" else torch.float32\n",
        ").to(device)\n",
        "model.eval()\n",
        "print(\"Model loaded on:\", device)\n",
        "\n",
        "# ---------- Chatbot response function ----------\n",
        "SYSTEM_PROMPT = \"You are a helpful and concise assistant.\"\n",
        "\n",
        "def generate_response(user_message, max_new_tokens=150, temperature=0.7, top_p=0.9):\n",
        "    \"\"\"Takes a user message and returns the model-generated reply.\"\"\"\n",
        "    try:\n",
        "        # 1. Handle empty input\n",
        "        if user_message is None or not user_message.strip():\n",
        "            return \"Please enter a valid message.\"\n",
        "\n",
        "        # 2. Prepare the prompt in the model's chat format\n",
        "        messages = [\n",
        "            {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
        "            {\"role\": \"user\", \"content\": user_message.strip()},\n",
        "        ]\n",
        "        prompt = tokenizer.apply_chat_template(\n",
        "            messages, tokenize=False, add_generation_prompt=True\n",
        "        )\n",
        "\n",
        "        # 3. Tokenize and generate with suitable settings\n",
        "        inputs = tokenizer(prompt, return_tensors=\"pt\").to(device)\n",
        "        with torch.no_grad():\n",
        "            output_ids = model.generate(\n",
        "                **inputs,\n",
        "                max_new_tokens=max_new_tokens,\n",
        "                do_sample=True,\n",
        "                temperature=temperature,\n",
        "                top_p=top_p,\n",
        "                repetition_penalty=1.1,\n",
        "                pad_token_id=tokenizer.eos_token_id,\n",
        "            )\n",
        "\n",
        "        # 4. Decode only the newly generated tokens\n",
        "        reply = tokenizer.decode(\n",
        "            output_ids[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True\n",
        "        )\n",
        "        return reply.strip()\n",
        "\n",
        "    # 5. Handle runtime errors\n",
        "    except torch.cuda.OutOfMemoryError:\n",
        "        return \"Error: GPU out of memory. Try a shorter prompt or fewer tokens.\"\n",
        "    except Exception as e:\n",
        "        return f\"Error: {str(e)}\"\n",
        "\n",
        "# ---------- Test with different prompts ----------\n",
        "test_prompts = [\n",
        "    \"What is the capital of France?\",                                  # factual\n",
        "    \"Hello! How are you today?\",                                       # conversational\n",
        "    \"Write a short email asking my teacher for a leave on Friday.\",    # task-oriented\n",
        "    \"Explain machine learning in two simple sentences.\",               # explanation\n",
        "    \"Give me 3 tips to prepare for an exam.\",                          # list\n",
        "    \"\",                                                                # empty input test\n",
        "]\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PROMPT TESTING\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "results = []\n",
        "for i, p in enumerate(test_prompts, 1):\n",
        "    answer = generate_response(p)\n",
        "    results.append((p, answer))\n",
        "    print(f\"\\nTest {i}\")\n",
        "    print(f\"User Prompt : {p if p else '(empty input)'}\")\n",
        "    print(f\"Bot Reply   : {answer}\")\n",
        "    print(\"-\" * 70)\n",
        "\n",
        "# ---------- Summary table ----------\n",
        "import pandas as pd\n",
        "pd.set_option(\"display.max_colwidth\", 80)\n",
        "df = pd.DataFrame(results, columns=[\"Prompt\", \"Response\"])\n",
        "df.index += 1\n",
        "df"
      ]
