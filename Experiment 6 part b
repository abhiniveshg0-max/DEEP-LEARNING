        "import tensorflow as tf\n",
        "import numpy as np\n",
        "from tensorflow.keras.layers import Embedding\n",
        "from tensorflow.keras.datasets import imdb\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "ROLL_NO = \"YOUR_ROLL_NO\"\n",
        "\n",
        "vocab_size = 10000\n",
        "embedding_dim = 128\n",
        "max_length = 200\n",
        "\n",
        "# Load the IMDB dataset\n",
        "(x_train, y_train), (x_test, y_test) = imdb.load_data(num_words=vocab_size)\n",
        "\n",
        "# Pad sequences to ensure they match max_length\n",
        "x_train = pad_sequences(x_train, maxlen=max_length)\n",
        "\n",
        "# Define the embedding layer without the deprecated input_length argument\n",
        "embedding_layer = Embedding(\n",
        "    input_dim=vocab_size,\n",
        "    output_dim=embedding_dim\n",
        ")\n",
        "\n",
        "sample_input = x_train[:5]\n",
        "\n",
        "embedding_output = embedding_layer(sample_input)\n",
        "\n",
        "print(\"Roll No:\", ROLL_NO)\n",
        "print(\"Vocabulary Size:\", vocab_size)\n",
        "print(\"Embedding Dimension:\", embedding_dim)\n",
        "print(\"Input Shape:\", sample_input.shape)\n",
        "print(\"Embedding Output Shape:\", embedding_output.shape)\n",
        "\n",
        "print(\"\\nEmbedding Representation of First Review:\")\n",
        "print(embedding_output[0])\n",
        "\n",
        "print(\"\\nEmbedding Vector of First Token:\")\n",
        "print(embedding_output[0][0])\n",
        "\n",
        "print(\"\\nEmbedding Vector Shape:\")\n",
        "print(embedding_output[0][0].shape)\n",
        "\n",
        "print(\"\\nEmbedding Layer Parameters:\")\n",
        "print(embedding_layer.count_params())"
      ]
