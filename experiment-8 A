        "# Experiment 8 - Part A: Dataset Preparation and Preprocessing\n",
        "# Student Roll Nos: 2XXXXXXXX, 2XXXXXXXX   <-- replace with your roll numbers\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from tensorflow.keras.datasets import mnist\n",
        "\n",
        "print(\"Student Roll Nos: 2XXXXXXXX, 2XXXXXXXX\")   # <-- replace here too\n",
        "print(\"-\" * 50)\n",
        "\n",
        "# 1. Load the MNIST dataset\n",
        "(x_train, y_train), (x_test, y_test) = mnist.load_data()\n",
        "\n",
        "# 2. Explore the dataset\n",
        "print(\"Training images shape :\", x_train.shape)\n",
        "print(\"Training labels shape :\", y_train.shape)\n",
        "print(\"Testing images shape  :\", x_test.shape)\n",
        "print(\"Testing labels shape  :\", y_test.shape)\n",
        "print(\"Number of training images:\", x_train.shape[0])\n",
        "print(\"Number of testing images :\", x_test.shape[0])\n",
        "print(\"Image dimensions         :\", x_train.shape[1], \"x\", x_train.shape[2])\n",
        "print(\"Pixel value range (raw)  :\", x_train.min(), \"to\", x_train.max())\n",
        "print(\"Data type (raw)          :\", x_train.dtype)\n",
        "\n",
        "# 3. Display sample images\n",
        "plt.figure(figsize=(10, 4))\n",
        "for i in range(10):\n",
        "    plt.subplot(2, 5, i + 1)\n",
        "    plt.imshow(x_train[i], cmap=\"gray\")\n",
        "    plt.title(f\"Label: {y_train[i]}\")\n",
        "    plt.axis(\"off\")\n",
        "plt.suptitle(\"Sample MNIST Images (Roll Nos: 2XXXXXXXX, 2XXXXXXXX)\")  # <-- replace\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 4. Convert to float32 and normalize to [0, 1]\n",
        "x_train = x_train.astype(\"float32\") / 255.0\n",
        "x_test = x_test.astype(\"float32\") / 255.0\n",
        "print(\"\\nAfter normalization:\")\n",
        "print(\"Data type        :\", x_train.dtype)\n",
        "print(\"Pixel value range:\", x_train.min(), \"to\", x_train.max())\n",
        "\n",
        "# 5. Flatten each 28x28 image into a 784-dimensional vector\n",
        "x_train = x_train.reshape((len(x_train), 28 * 28))\n",
        "x_test = x_test.reshape((len(x_test), 28 * 28))\n",
        "print(\"\\nAfter flattening:\")\n",
        "print(\"x_train shape:\", x_train.shape)\n",
        "print(\"x_test shape :\", x_test.shape)\n",
        "\n",
        "# 6. Prepare training and testing data\n",
        "#    For an autoencoder, the input is also the target output\n",
        "x_train_input, x_train_target = x_train, x_train\n",
        "x_test_input, x_test_target = x_test, x_test\n",
        "\n",
        "print(\"\\nAutoencoder data prepared:\")\n",
        "print(\"Train input  :\", x_train_input.shape, \"| Train target:\", x_train_target.shape)\n",
        "print(\"Test input   :\", x_test_input.shape, \"| Test target :\", x_test_target.shape)\n",
        "print(\"Input dimension per sample:\", x_train_input.shape[1])"
      ]
