        "# PART B: IMPLEMENTING THE GENERATOR\n",
        "# Student Name: YOUR NAME\n",
        "# Student Roll No: YOUR ROLL NUMBER\n",
        "\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Display student details\n",
        "print(\"Student Name: YOUR NAME\")\n",
        "print(\"Student Roll No: YOUR ROLL NUMBER\")\n",
        "\n",
        "# Step 1: Define random noise vector dimension\n",
        "latent_dim = 100\n",
        "\n",
        "# Step 2: Create the Generator model\n",
        "generator = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(latent_dim,)),\n",
        "\n",
        "    # Fully connected layer\n",
        "    tf.keras.layers.Dense(7 * 7 * 128, use_bias=False),\n",
        "\n",
        "    # Normalize activations\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    # Reshape feature maps\n",
        "    tf.keras.layers.Reshape((7, 7, 128)),\n",
        "\n",
        "    # Upsample from 7x7 to 14x14\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        64,\n",
        "        kernel_size=5,\n",
        "        strides=2,\n",
        "        padding=\"same\",\n",
        "        use_bias=False\n",
        "    ),\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    # Upsample from 14x14 to 28x28\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        1,\n",
        "        kernel_size=5,\n",
        "        strides=2,\n",
        "        padding=\"same\",\n",
        "        activation=\"tanh\"\n",
        "    )\n",
        "], name=\"Generator\")\n",
        "\n",
        "# Step 3: Display Generator architecture\n",
        "print(\"\\nGENERATOR MODEL SUMMARY\")\n",
        "generator.summary()\n",
        "\n",
        "# Step 4: Generate a random noise vector\n",
        "noise = tf.random.normal([1, latent_dim])\n",
        "\n",
        "print(\"\\nRandom Noise Vector Shape:\", noise.shape)\n",
        "\n",
        "# Step 5: Generate an image before GAN training\n",
        "generated_image = generator(noise, training=False)\n",
        "\n",
        "print(\"Generated Image Shape:\", generated_image.shape)\n",
        "print(\"Minimum Pixel Value:\",\n",
        "      float(tf.reduce_min(generated_image)))\n",
        "print(\"Maximum Pixel Value:\",\n",
        "      float(tf.reduce_max(generated_image)))\n",
        "\n",
        "# Step 6: Display the generated image\n",
        "image = (generated_image[0, :, :, 0] + 1.0) / 2.0\n",
        "\n",
        "plt.figure(figsize=(5, 5))\n",
        "plt.imshow(image.numpy(), cmap=\"gray\", vmin=0, vmax=1)\n",
        "plt.title(\"Generated Image Before GAN Training\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "# Step 7: Verify the output\n",
        "assert generated_image.shape == (1, 28, 28, 1)\n",
        "assert np.isfinite(generated_image.numpy()).all()\n",
        "\n",
        "print(\"\\nGenerator implemented successfully!\")\n",
        "print(\"Input: Random noise vector of dimension 100\")\n",
        "print(\"Output: 28 x 28 grayscale image\")\n",
        "print(\"Output activation: Tanh\")\n",
        "print(\"Status: Ready for GAN training\")"
