        "# PART C: IMPLEMENTING THE DISCRIMINATOR AND GAN MODEL\n",
        "# Student Name: YOUR NAME\n",
        "# Student Roll No: YOUR ROLL NUMBER\n",
        "\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "\n",
        "print(\"Student Name: YOUR NAME\")\n",
        "print(\"Student Roll No: YOUR ROLL NUMBER\")\n",
        "print(\"TensorFlow Version:\", tf.__version__)\n",
        "\n",
        "# ==========================================\n",
        "# STEP 1: DEFINE THE GENERATOR\n",
        "# ==========================================\n",
        "\n",
        "latent_dim = 100\n",
        "\n",
        "generator = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(latent_dim,)),\n",
        "\n",
        "    tf.keras.layers.Dense(7 * 7 * 128, use_bias=False),\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    tf.keras.layers.Reshape((7, 7, 128)),\n",
        "\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        64, kernel_size=5, strides=2,\n",
        "        padding=\"same\", use_bias=False\n",
        "    ),\n",
        "    tf.keras.layers.BatchNormalization(),\n",
        "    tf.keras.layers.ReLU(),\n",
        "\n",
        "    tf.keras.layers.Conv2DTranspose(\n",
        "        1, kernel_size=5, strides=2,\n",
        "        padding=\"same\", activation=\"tanh\"\n",
        "    )\n",
        "], name=\"Generator\")\n",
        "\n",
        "# ==========================================\n",
        "# STEP 2: DEFINE THE DISCRIMINATOR\n",
        "# ==========================================\n",
        "\n",
        "discriminator = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(28, 28, 1)),\n",
        "\n",
        "    # Extract image features\n",
        "    tf.keras.layers.Conv2D(\n",
        "        64, kernel_size=5, strides=2, padding=\"same\"\n",
        "    ),\n",
        "    tf.keras.layers.LeakyReLU(negative_slope=0.2),\n",
        "    tf.keras.layers.Dropout(0.3),\n",
        "\n",
        "    tf.keras.layers.Conv2D(\n",
        "        128, kernel_size=5, strides=2, padding=\"same\"\n",
        "    ),\n",
        "    tf.keras.layers.LeakyReLU(negative_slope=0.2),\n",
        "    tf.keras.layers.Dropout(0.3),\n",
        "\n",
        "    # Flatten feature maps\n",
        "    tf.keras.layers.Flatten(),\n",
        "\n",
        "    # Binary classification:\n",
        "    # 1 = Real image, 0 = Generated image\n",
        "    tf.keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "], name=\"Discriminator\")\n",
        "\n",
        "# ==========================================\n",
        "# STEP 3: COMPILE THE DISCRIMINATOR\n",
        "# ==========================================\n",
        "\n",
        "discriminator.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0002),\n",
        "    loss=\"binary_crossentropy\",\n",
        "    metrics=[\"accuracy\"]\n",
        ")\n",
        "\n",
        "print(\"\\nDiscriminator compiled successfully!\")\n",
        "\n",
        "# ==========================================\n",
        "# STEP 4: COMBINE GENERATOR AND DISCRIMINATOR\n",
        "# ==========================================\n",
        "\n",
        "# Freeze Discriminator weights while training the combined GAN.\n",
        "# It remains trainable when used separately for its own training.\n",
        "discriminator.trainable = False\n",
        "\n",
        "gan_input = tf.keras.layers.Input(shape=(latent_dim,))\n",
        "\n",
        "generated_image = generator(gan_input)\n",
        "gan_output = discriminator(generated_image)\n",
        "\n",
        "gan = tf.keras.Model(\n",
        "    gan_input,\n",
        "    gan_output,\n",
        "    name=\"Generative_Adversarial_Network\"\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# STEP 5: COMPILE THE GAN MODEL\n",
        "# ==========================================\n",
        "\n",
        "gan.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.0002),\n",
        "    loss=\"binary_crossentropy\"\n",
        ")\n",
        "\n",
        "print(\"GAN model compiled successfully!\")\n",
