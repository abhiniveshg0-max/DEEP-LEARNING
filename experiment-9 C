        "# Experiment 9 - Part C: Sequence-to-Sequence Application using T5-small\n",
        "# Student Roll Nos: 2XXXXXXXX, 2XXXXXXXX   <-- replace with your roll numbers\n",
        "\n",
        "!pip install -q sentencepiece\n",
        "\n",
        "import torch\n",
        "import pandas as pd\n",
        "from transformers import T5Tokenizer, T5ForConditionalGeneration\n",
        "\n",
        "# Define the device\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "print(\"Student Roll Nos: 2XXXXXXXX, 2XXXXXXXX\")   # <-- replace here too\n",
        "print(\"-\" * 60)\n",
        "\n",
        "# 1. Load pretrained T5-small and its tokenizer\n",
        "t5_name = \"t5-small\"\n",
        "t5_tokenizer = T5Tokenizer.from_pretrained(t5_name)\n",
        "t5_model = T5ForConditionalGeneration.from_pretrained(t5_name).to(device)\n",
        "print(\"Loaded:\", t5_name)\n",
        "\n",
        "# 2. Generation function (T5 needs a task prefix such as \"summarize: \")\n",
        "def generate_text(prompt, max_length=60, num_beams=1, **kwargs):\n",
        "    inputs = t5_tokenizer(prompt, return_tensors=\"pt\",\n",
        "                          truncation=True, max_length=512).to(device)\n",
        "    output_ids = t5_model.generate(**inputs, max_length=max_length,\n",
        "                                   num_beams=num_beams, early_stopping=True, **kwargs)\n",
        "    return t5_tokenizer.decode(output_ids[0], skip_special_tokens=True)\n",
        "\n",
        "# 3. Sample input text for summarization\n",
        "article = (\"Artificial intelligence is transforming industries around the world. \"\n",
        "           \"In healthcare, AI systems help doctors detect diseases earlier by analysing \"\n",
        "           \"medical images. In finance, banks use AI to detect fraud and assess risk. \"\n",
        "           \"In education, adaptive learning platforms personalise lessons for each \"\n",
        "           \"student. However, experts warn that AI also raises concerns about privacy, \"\n",
        "           \"job displacement and bias, so governments are working on regulations.\")\n",
        "\n",
        "print(\"\\nINPUT TEXT:\\n\", article)\n",
        "\n",
        "# 4. Generate with different settings\n",
        "results = []\n",
        "settings = [\n",
        "    (\"Greedy, max_length=20\",  dict(max_length=20, num_beams=1)),\n",
        "    (\"Greedy, max_length=60\",  dict(max_length=60, num_beams=1)),\n",
        "    (\"Beam search (4), max_length=60\", dict(max_length=60, num_beams=4)),\n",
        "    (\"Beam search (4), max_length=20\", dict(max_length=20, num_beams=4)),\n",
        "]\n",
        "print(\"\\n========== SUMMARIZATION WITH DIFFERENT SETTINGS ==========\")\n",
        "for name, params in settings:\n",
        "    out = generate_text(\"summarize: \" + article, **params)\n",
        "    print(f\"\\n[{name}]\\n{out}\")\n",
        "    results.append({\"Task\": \"Summarization\", \"Setting\": name,\n",
        "                    \"Input\": article[:80] + \"...\", \"Output\": out})\n",
        "\n",
        "# 5. Experiment with different inputs and tasks\n",
        "print(\"\\n========== OTHER INPUTS / TASKS ==========\")\n",
        "other_inputs = [\n",
        "    (\"Translation EN->DE\", \"translate English to German: The weather is very nice today.\"),\n",
        "    (\"Translation EN->FR\", \"translate English to French: I love learning about machine learning.\"),\n",
        "    (\"Summarization\", \"summarize: The Amazon rainforest produces about twenty percent of the \"\n",
        "                      \"world's oxygen and is home to millions of species. It is being cleared \"\n",
        "                      \"rapidly for farming and logging, which threatens wildlife and climate.\"),\n",
        "]\n",
        "for task, prompt in other_inputs:\n",
        "    out = generate_text(prompt, max_length=50, num_beams=4)\n",
        "    print(f\"\\n[{task}]\\nInput : {prompt}\\nOutput: {out}\")\n",
        "    results.append({\"Task\": task, \"Setting\": \"Beam search (4), max_length=50\",\n",
        "                    \"Input\": prompt[:80] + \"...\", \"Output\": out})\n",
        "\n",
        "# 6. Save generated outputs for further analysis\n",
        "df_out = pd.DataFrame(results)\n",
        "df_out.to_csv(\"t5_generated_outputs.csv\", index=False)\n",
        "print(\"\\nGenerated outputs saved to: t5_generated_outputs.csv\")"
      ]
